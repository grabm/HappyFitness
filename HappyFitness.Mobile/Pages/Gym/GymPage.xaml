<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="HappyFitness.Mobile.Pages.Gym.GymPage"
             Title="Siłownia"
             >

    <Grid RowDefinitions="Auto, *" Padding="20" RowSpacing="20">
        <Button Grid.Row="0" Text="Rozpocznij nowy trening" />
        <VerticalStackLayout Grid.Row="1" Spacing="10">
            <Label Text="Historia treningów" />
            <CollectionView ItemsSource="{Binding PastWorkouts}">
            </CollectionView>
        </VerticalStackLayout>
    </Grid>
</ContentPage>