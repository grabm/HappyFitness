<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="HappyFitness.Mobile.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:HappyFitness.Mobile"
    xmlns:gym="clr-namespace:HappyFitness.Mobile.Pages.Gym"
    xmlns:diary="clr-namespace:HappyFitness.Mobile.Pages.Diary"
    xmlns:records="clr-namespace:HappyFitness.Mobile.Pages.Records"
    xmlns:profile="clr-namespace:HappyFitness.Mobile.Pages.Profile"
    Shell.FlyoutBehavior="Disabled"
    Title="HappyFitness.Mobile">

    <TabBar>

        <Tab Title="Dziennik" Icon="icon_diary.svg">
            <ShellContent
            ContentTemplate="{DataTemplate diary:DiaryPage}"
            Route="DiaryPage" />
        </Tab>

        <Tab Title="Siłownia" Icon="icon_gym.svg">
            <ShellContent
            ContentTemplate="{DataTemplate gym:GymPage}"
            Route="GymPage" />
        </Tab>

        <Tab Title="Rekordy" Icon="icon_records.svg">
            <ShellContent
            ContentTemplate="{DataTemplate records:RecordsPage}"
            Route="RecordsPage" />
        </Tab>

        <Tab Title="Profil" Icon="icon_profile.svg">
            <ShellContent
            ContentTemplate="{DataTemplate profile:ProfilePage}"
            Route="ProfilePage" />
        </Tab>

    </TabBar>

</Shell>
