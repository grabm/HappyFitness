<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="HappyFitness.MAUI.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:gym="clr-namespace:HappyFitness.MAUI.Pages.Gym"
    xmlns:diary="clr-namespace:HappyFitness.MAUI.Pages.Diary"
    xmlns:records="clr-namespace:HappyFitness.MAUI.Pages.Records"
    xmlns:profile="clr-namespace:HappyFitness.MAUI.Pages.Profile"
    Shell.FlyoutBehavior="Disabled"
    Title="HappyFitness.MAUI">

    <TabBar>

        <Tab Title="Dziennik" Icon="icon_diary.svg">
            <ShellContent
                ContentTemplate="{DataTemplate diary:DiaryPage}"
                Route="DiaryPage" />
        </Tab>

        <Tab Title="Siłownia" Icon="icon_gym.svg">
            <ShellContent
                ContentTemplate="{DataTemplate gym:GymPage}"
                Route="GymPage" />
        </Tab>

        <Tab Title="Rekordy" Icon="icon_records.svg">
            <ShellContent
                ContentTemplate="{DataTemplate records:RecordsPage}"
                Route="RecordsPage" />
        </Tab>

        <Tab Title="Profil" Icon="icon_profile.svg">
            <ShellContent
                ContentTemplate="{DataTemplate profile:ProfilePage}"
                Route="ProfilePage" />
        </Tab>

    </TabBar>

</Shell>
